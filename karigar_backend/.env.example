# ─────────────────────────────────────────────────────────────────────────────
# Karigar Backend — Required Environment Variables
# Copy this file to .env and fill in your IBM Cloud credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM Watsonx AI ─────────────────────────────────────────────────────────
# API key for IBM Cloud IAM authentication (used by Granite LLM)
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# Watsonx.ai project ID (find in IBM Watsonx platform → your project → Manage)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ── IBM Cloudant NoSQL ─────────────────────────────────────────────────────
# IAM API key scoped to your Cloudant instance
CLOUDANT_API_KEY=your_cloudant_api_key_here

# Cloudant service URL (e.g. https://xxxx-bluemix.cloudantnosqldb.appdomain.cloud)
CLOUDANT_URL=https://your-instance.cloudantnosqldb.appdomain.cloud

# Database name where worker cases are stored
CLOUDANT_DB_NAME=karigar_app_db

# ── CORS ───────────────────────────────────────────────────────────────────
# In production: set to your Flutter Web / Code Engine frontend URL
# In development: leave as * (default)
CORS_ORIGIN=*
